1170: };
1171: /* MARK: - Prefixed Instruction Set Selection and Execution */
1172: #define DD_FD(register)						       \
1173: 	zuint8 cycles;						       \
1174: 								       \
1175: 	XY = register;						       \
1176: 	R++;							       \
1177: 	cycles = instruction_table_XY[BYTE1 = READ_8(PC + 1)](object); \
1178: 	register = XY;						       \
1179: 	return cycles;
1180: INSTRUCTION(DD) {DD_FD(IX)}
1181: INSTRUCTION(FD) {DD_FD(IY)}
1182: INSTRUCTION(CB) {R++; return instruction_table_CB[BYTE1 = READ_8((PC += 2) - 1)](object);}
1183: INSTRUCTION(ED) {R++; return instruction_table_ED[BYTE1 = READ_8( PC	   + 1)](object);}
1184: INSTRUCTION(XY_CB)
1185: 	{
1186: 	PC += 4;
1187: 	BYTE2 = READ_8(PC - 2);
1188: 	return instruction_table_XY_CB[BYTE3 = READ_8(PC - 1)](object);
1189: 	}
1190: /* MARK: - Illegal Instruction Handling */
1191: INSTRUCTION(XY_illegal) {PC += 1; return instruction_table[BYTE0 = BYTE1](object) + 4;}
1192: INSTRUCTION(ED_illegal) {PC += 2; return 8;}
1193: INSTRUCTION(hook) {HOOK(PC); return 0;}	/* SNO */
