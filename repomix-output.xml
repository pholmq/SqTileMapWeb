 23: /** Z80 emulator instance.
 24:   * @details This structure contains the state of the emulated CPU and callback
 25:   * pointers necessary to interconnect the emulator with external logic. There
 26:   * is no constructor function, so, before using an object of this type, some
 27:   * of its members must be initialized, in particular the following:
 28:   * @c context, @c read, @c write, @c in, @c out, @c int_data and @c halt. */
 29: typedef struct {
 30: 	/** Number of cycles executed in the current call to @c z80_run.
 31: 	  * @details @c z80run sets this variable to @c 0 before starting
 32: 	  * to execute instructions and its value persists after returning.
 33: 	  * The callbacks can use this variable to know during what cycle
 34: 	  * they are being called. */
 35: 	zusize cycles;
 36: 	/** The value used as the first argument when calling a callback.
 37: 	  * @details This variable should be initialized before using the
 38: 	  * emulator and can be used to reference the context/instance of
 39: 	  * the machine being emulated. */
 40: 	void *context;
 41: 	/** Callback: Called when the CPU needs to read 8 bits from memory.
 42: 	  * @param context The value of the member @c context.
 43: 	  * @param address The memory address to read from.
 44: 	  * @return The 8 bits read from memory. */
 45: 	zuint8 (* read)(void *context, zuint16 address);
 46: 	/** Callback: Called when the CPU needs to write 8 bits to memory.
 47: 	  * @param context The value of the member @c context.
 48: 	  * @param address The memory address to write to.
 49: 	  * @param value The value to write. */
 50: 	void (* write)(void *context, zuint16 address, zuint8 value);
 51: 	/** Callback: Called when the CPU needs to read 8 bits from an I/O port.
 52: 	  * @param context The value of the member @c context.
 53: 	  * @param port The number of the I/O port to read from.
 54: 	  * @return The 8 bits read from the I/O port. */
 55: 	zuint8 (* in)(void *context, zuint16 port);
 56: 	/** Callback: Called when the CPU needs to write 8 bits to an I/O port.
 57: 	  * @param context The value of the member @c context.
 58: 	  * @param port The number of the I/O port to write to.
 59: 	  * @param value The value to write. */
 60: 	void (* out)(void *context, zuint16 port, zuint8 value);
 61: 	/** Callback: Called when the CPU needs to read one instruction from
 62: 	  * the data bus to service a maskable interrupt (INT) in mode 0.
 63: 	  * @param context The value of the member @c context.
 64: 	  * @return A 32-bit value containing the bytes of one instruction. The
 65: 	  * instruction must begin at the most significant byte (big endian). */
 66: 	zuint32 (* int_data)(void *context);
 67: 	/** Callback: Called when the CPU enters or exits the halt state.
 68: 	  * @param context The value of the member @c context.
 69: 	  * @param state @c TRUE if halted; @c FALSE otherwise.
 70: 	  * @note This callback is optional and must be set to @c NULL if not
 71: 	  * used. */
 72: 	void (* halt)(void *context, zboolean state);
 73: 	/** Callback: Called when the LD H,H opcode is executed.
 74: 	  * @param context The value of the member @c context.
 75: 	  * @param address The current program counter address. */
 76: 	void(* hook)(void *context, zuint16 address);
 77: 	/** CPU registers and internal bits.
 78: 	  * @details It contains the state of the registers, as well as the
 79: 	  * interrupt flip-flops, variables related to interrupts and other
 80: 	  * necessary flags. This is what a debugger should use as its data
 81: 	  * source. */
 82: 	ZZ80State state;
 83: 	/** Backup of the 7th bit of the R register.
 84: 	  * @details The value of the R register is incremented as instructions
 85: 	  * are executed, but its most significant bit remains unchanged. For
 86: 	  * optimization reasons, this bit is saved at the beginning of the
 87: 	  * execution of @c z80_run and restored before returning. If an
 88: 	  * instruction directly affects the R register, this variable is also
 89: 	  * updated accordingly. */
 90: 	zuint8 r7;
 91: 	/** Temporay IX/IY register for instructions with @c DDh/FDh prefix.
 92: 	  * @details Since instructions with prefix @c DDh and @c FDh behave
 93: 	  * similarly, differing only in the use of register IX or IY, for
 94: 	  * reasons of size optimization, a single register is used that acts
 95: 	  * as both. During opcode analysis, the IX or IY register is copied
 96: 	  * to this variable and, once the instruction emulation is complete,
 97: 	  * its contents are copied back to the appropriate register. */
 98: 	Z16Bit xy;
 99: 	/** Temporary storage for opcode fetching.
100: 	  * @details This is an internal private variable. */
101: 	Z32Bit data;
102: } Z80;
