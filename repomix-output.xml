 56:   heap.set(snapshot, snapshotPtr);
 57:   heap.set(rom, romPtr);
 58:   const code = e.emu_init(snapshotPtr, snapshot.byteLength, romPtr, rom.byteLength, message.cheats ? 1 : 0);
