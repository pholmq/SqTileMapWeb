10: const pixelLookup = new Uint32Array(2 * 256 * 256 * 8);
11: for (let flash = 0; flash < 2; flash++) {
12:   for (let attr = 0; attr < 256; attr++) {
13:     const colours = palette[(attr >> 6) & 1];
14:     const ink = attr & 7;
15:     const paper = (attr >> 3) & 7;
16:     const swap = flash && (attr & 0x80) !== 0;
17:     for (let bitmap = 0; bitmap < 256; bitmap++) {
18:       const base = (((flash * 256 + attr) * 256 + bitmap) * 8);
19:       for (let bit = 0; bit < 8; bit++) {
20:         const set = ((bitmap >> (7 - bit)) & 1) !== 0;
21:         const colour = colours[(set !== Boolean(swap)) ? ink : paper];
22:         pixelLookup[base + bit] = (255 << 24) | (colour[2] << 16) | (colour[1] << 8) | colour[0];
23:       }
24:     }
25:   }
26: }
27: const imageDataCache = new WeakMap<CanvasRenderingContext2D, ImageData>();
