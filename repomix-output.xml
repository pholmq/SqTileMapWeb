 160: VF(sub, -)
 161: #undef	VF
 162: #define VF(function, bits, type, operand, minimum, maximum)					\
 163: static Z_INLINE zuint8 pf_overflow_##function##bits(zuint##bits a, zuint##bits b, zuint8 carry) \
 164: 	{											\
 165: 	type total = ((type)((zsint##bits)a)) operand ((type)((zsint##bits)b)) operand carry;	\
 166: 												\
 167: 	return total < minimum || total > maximum ? PF : 0;					\
 168: 	}
