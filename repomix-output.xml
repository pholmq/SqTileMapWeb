 552: static Z_INLINE void add_RR_NN(Z80 *object, zuint16 *r, zuint16 v)
 553: 	{
 554: 	zuint16 t = *r + v;
 555: 	F =	F_SZP			     /* SF, ZF, PF unchanged   */
 556: 		| ((t >> 8) & YXF)	     /* YF = RR.13; XF = RR.11 */
 557: 		| (((*r ^ v ^ t) >> 8) & HF) /* HF = RRh half-carry    */
 558: 		| ((zuint32)*r + v > 65535); /* CF = Carry	       */
 559: 	*r = t;				     /* NF = 0		       */
 560: 	}
 561: #define ADD_RR_NN(register, value) \
 562: 	add_RR_NN(object, (zuint16 *)&register, value);
 563: #define ADC_SBC_HL_SS(function, sign, cf_test, set_nf)								 \
 564: 	zuint8 c = F_C;												 \
 565: 	zuint16 v = SS1, t = HL sign v sign c;									 \
 566: 														 \
 567: 	F = (zuint8)												 \
 568: 		(((t >> 8) & SYXF)					/* SF = HL.15; YF = HL.13; XF = HL.11 */ \
 569: 		 | ZF_ZERO(t)						/* ZF = !HL			      */ \
 570: 		 | ((((HL & 0xFFF) sign (v & 0xFFF) sign c) >> 8) & HF) /* HF = Half-carry of H		      */ \
 571: 		 | pf_overflow_##function##16(HL, v, c)			/* PF = Overflow		      */ \
 572: 		 | !!(cf_test)						/* CF = Carry			      */ \
 573: 		 set_nf);						/* ADC: NF = 0; SBC: NF = 1	      */ \
 574: 														 \
