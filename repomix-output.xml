1195: CPU_Z80_API void z80_power(Z80 *object, zboolean state)
1196: 	{
1197: 	if (state)
1198: 		{
1199: #		ifdef Z_Z80_RESET_IS_EQUAL_TO_POWER_ON
1200: 			z80_reset(object);
1201: #		else
1202: 			PC   = Z_Z80_VALUE_AFTER_POWER_ON_PC;
1203: 			SP   = Z_Z80_VALUE_AFTER_POWER_ON_SP;
1204: 			IX   = Z_Z80_VALUE_AFTER_POWER_ON_IX;
1205: 			IY   = Z_Z80_VALUE_AFTER_POWER_ON_IY;
1206: 			AF   = Z_Z80_VALUE_AFTER_POWER_ON_AF;
1207: 			BC   = Z_Z80_VALUE_AFTER_POWER_ON_BC;
1208: 			DE   = Z_Z80_VALUE_AFTER_POWER_ON_DE;
1209: 			HL   = Z_Z80_VALUE_AFTER_POWER_ON_HL;
1210: 			AF_  = Z_Z80_VALUE_AFTER_POWER_ON_AF_;
1211: 			BC_  = Z_Z80_VALUE_AFTER_POWER_ON_BC_;
1212: 			DE_  = Z_Z80_VALUE_AFTER_POWER_ON_DE_;
1213: 			HL_  = Z_Z80_VALUE_AFTER_POWER_ON_HL_;
1214: 			R    = Z_Z80_VALUE_AFTER_POWER_ON_R;
1215: 			I    = Z_Z80_VALUE_AFTER_POWER_ON_I;
1216: 			IFF1 = Z_Z80_VALUE_AFTER_POWER_ON_IFF1;
1217: 			IFF2 = Z_Z80_VALUE_AFTER_POWER_ON_IFF2;
1218: 			IM   = Z_Z80_VALUE_AFTER_POWER_ON_IM;
1219: 			EI = HALT = INT = NMI = 0;
1220: #		endif
1221: 		}
1222: 	else	PC = SP = IX = IY = AF = BC = DE = HL = AF_ = BC_ = DE_ = HL_ = I = R =
1223: 		IFF1 = IFF2 = IM = EI = HALT = INT = NMI = 0;
1224: 	}
1225: CPU_Z80_API void z80_reset(Z80 *object)
1226: 	{
1227: 	PC   = Z_Z80_VALUE_AFTER_RESET_PC;
1228: 	SP   = Z_Z80_VALUE_AFTER_RESET_SP;
1229: 	IX   = Z_Z80_VALUE_AFTER_RESET_IX;
1230: 	IY   = Z_Z80_VALUE_AFTER_RESET_IY;
1231: 	AF   = Z_Z80_VALUE_AFTER_RESET_AF;
1232: 	BC   = Z_Z80_VALUE_AFTER_RESET_BC;
1233: 	DE   = Z_Z80_VALUE_AFTER_RESET_DE;
1234: 	HL   = Z_Z80_VALUE_AFTER_RESET_HL;
1235: 	AF_  = Z_Z80_VALUE_AFTER_RESET_AF_;
1236: 	BC_  = Z_Z80_VALUE_AFTER_RESET_BC_;
1237: 	DE_  = Z_Z80_VALUE_AFTER_RESET_DE_;
1238: 	HL_  = Z_Z80_VALUE_AFTER_RESET_HL_;
1239: 	R    = Z_Z80_VALUE_AFTER_RESET_R;
1240: 	I    = Z_Z80_VALUE_AFTER_RESET_I;
1241: 	IFF1 = Z_Z80_VALUE_AFTER_RESET_IFF1;
1242: 	IFF2 = Z_Z80_VALUE_AFTER_RESET_IFF2;
1243: 	IM   = Z_Z80_VALUE_AFTER_RESET_IM;
1244: 	EI = HALT = INT = NMI = 0;
1245: 	}
1246: CPU_Z80_API zusize z80_run(Z80 *object, zusize cycles)
1247: 	{
1248: 	zuint32 data;
1249: 	/*-------------.
1250: 	| Clear cycles |
1251: 	'-------------*/
1252: 	CYCLES = 0;
1253: 	/*--------------.
1254: 	| Backup R7 bit |
1255: 	'--------------*/
1256: 	R7 = R;
1257: 	/*------------------------------.
1258: 	| Execute until cycles consumed |
1259: 	'------------------------------*/
1260: 	while (CYCLES < cycles)
1261: 		{
1262: 		/*--------------------------------------.
1263: 		| Jump to NMI handler if NMI pending... |
1264: 		'--------------------------------------*/
1265: 		if (NMI)
1266: 			{
1267: 			EXIT_HALT;			/* Resume CPU if halted.				   */
1268: 			R++;				/* Consume memory refresh.				   */
1269: 			NMI = FALSE;			/* Clear the NMI pulse.					   */
1270: 			/*IFF2 = IFF1;*/		/* Backup IFF1 (it doesn't occur, acording to Sean Young). */
1271: 			IFF1 = 0;			/* Reset IFF1 to don't bother the NMI routine.		   */
1272: 			PUSH(PC);			/* Save return addres in the stack.			   */
1273: 			PC = Z_Z80_ADDRESS_NMI_POINTER;	/* Make PC point to the NMI routine.			   */
1274: 			CYCLES += 11;			/* Accepting a NMI consumes 11 cycles.			   */
1275: 			continue;
1276: 			}
1277: 		/*--------------------------.
1278: 		| Execute INT if pending... |
1279: 		'--------------------------*/
1280: 		if (INT && IFF1 && !EI)
1281: 			{
1282: 			EXIT_HALT;	 /* Resume CPU on halt.		*/
1283: 			R++;		 /* Consume memory refresh.	*/
1284: 			IFF1 = IFF2 = 0; /* Clear interrupt flip-flops.	*/
1285: 			switch (IM)
1286: 				{
1287: 				/*------------------------------.
1288: 				| IM 0: Execute bus instruction |
1289: 				'------------------------------*/
1290: 				case 0:
1291: 				if ((data = INT_DATA)) switch (data & Z_UINT32(0xFF000000))
1292: 					{
1293: 					case Z_UINT32(0xC3000000): /* JP */
1294: 					PC = (zuint16)(data >> 8);
1295: 					CYCLES += 10;
1296: 					break;
1297: 					case Z_UINT32(0xCD000000): /* CALL */
1298: 					PUSH(PC);
1299: 					PC = (zuint16)(data >> 8);
1300: 					CYCLES += 17;
1301: 					break;
1302: 					default: /* RST (and possibly others) */
1303: 					PUSH(PC);
1304: 					PC = (zuint16)((data >> 8) & 0x38);
1305: 					CYCLES += 11;
1306: 					}
1307: 				CYCLES += 2;
1308: 				break;
1309: 				/*----------------------.
1310: 				| IM 1: Execute rst 38h |
1311: 				'----------------------*/
1312: 				case 1:
1313: 				PUSH(PC);
1314: 				PC = 0x38;
1315: 				CYCLES += (11 + 2);
1316: 				break;
1317: 				/*---------------------------.
1318: 				| IM 2: Execute rst [i:byte] |
1319: 				'---------------------------*/
1320: 				case 2:
1321: 				PUSH(PC);
1322: 				PC = READ_16(((zuint16)(I << 8)) | (INT_DATA & 0xFF));
1323: 				CYCLES += (17 + 2);
1324: 				break;
1325: 				}
1326: 			continue;
1327: 			}
1328: 		/*---------------------------------------.
1329: 		| Consume memory refresh and update bits |
1330: 		'---------------------------------------*/
1331: 		R++;
1332: 		EI = FALSE;
1333: 		/*-----------------------------------------------.
1334: 		| Execute instruction and update consumed cycles |
1335: 		'-----------------------------------------------*/
1336: 		CYCLES += instruction_table[BYTE0 = READ_8(PC)](object);
1337: 		}
1338: 	/*---------------.
1339: 	| Restore R7 bit |
1340: 	'---------------*/
1341: 	R = R_ALL;
1342: 	/*-----------------------.
1343: 	| Return consumed cycles |
1344: 	'-----------------------*/
1345: 	return CYCLES;
1346: 	}
1347: CPU_Z80_API void z80_nmi(Z80 *object)		      {NMI = TRUE ;}
1348: CPU_Z80_API void z80_int(Z80 *object, zboolean state) {INT = state;}
