  1: /// <reference lib="webworker" />
  2: type ModuleMessage = { type: 'module'; memory?: WebAssembly.Memory; shared: boolean; workerIndex: number; workerCount: number };
  3: type InitMessage = { type: 'init'; snapshot: ArrayBuffer; rom: ArrayBuffer; cheats: boolean };
  4: type KeyMessage = { type: 'keys'; rows: number[] };
  5: type BeginMessage = { type: 'begin'; frameId: number };
  6: type TickMessage = { type: 'tick'; frameId: number; backgroundDivisor: number; minCol: number; maxCol: number; minRow: number; maxRow: number };
  7: type CollectMessage = { type: 'collect'; frameId: number; forceRoom?: number };
  8: type DebugMessage = { type: 'debug-capture'; captureId: number };
  9: type Incoming = ModuleMessage | InitMessage | KeyMessage | BeginMessage | TickMessage | CollectMessage | DebugMessage | { type: 'stop' };
 10: let wasm: WebAssembly.Exports | null = null;
 11: let memory: WebAssembly.Memory | null = null;
 12: let workerIndex = 0;
 13: let workerCount = 1;
 14: let shared = false;
 15: let rangeStart = 0;
 16: let rangeEnd = 512;
 17: const scope = self as unknown as DedicatedWorkerGlobalScope;
