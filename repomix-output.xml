103:       collect(message.frameId, message.forceRoom ?? -1);
104:     } else if (message.type === 'debug-capture' && wasm && memory) {
105:       const e = wasm as Record<string, any>;
106:       const heap = new Uint8Array(memory.buffer);
107:       const room = e.emu_current_room() | 0;
108:       const hasWriteTrace = ['emu_debug_ram_ptr', 'emu_debug_pc', 'emu_debug_sp', 'emu_debug_write_ptr', 'emu_debug_write_count', 'emu_debug_write_capacity', 'emu_debug_clear_writes'].every(name => typeof e[name] === 'function');
109:       const ramPointer = (hasWriteTrace ? e.emu_debug_ram_ptr() : e.emu_screen_ptr(room)) >>> 0;
110:       const ram = heap.slice(ramPointer, ramPointer + 49152);
111:       const writeCount = hasWriteTrace ? Math.max(0, e.emu_debug_write_count() | 0) : 0;
112:       const writeCapacity = hasWriteTrace ? e.emu_debug_write_capacity() | 0 : 0;
113:       const writeBytes = Math.min(writeCount, writeCapacity) * 8;
114:       const writes = new Uint8Array(writeBytes);
115:       if (hasWriteTrace && writeCapacity > 0) {
116:         const writePointer = e.emu_debug_write_ptr() >>> 0;
117:         const firstRecord = writeCount > writeCapacity ? writeCount % writeCapacity : 0;
118:         for (let i = 0; i < writeBytes; i++) {
119:           writes[i] = heap[writePointer + ((firstRecord * 8 + i) % (writeCapacity * 8))];
120:         }
121:       }
122:       const result = {
123:         captureId: message.captureId,
124:         capturedAt: new Date().toISOString(),
125:         room,
126:         pc: (hasWriteTrace ? e.emu_debug_pc() : e.emu_room_pc(room)) & 0xffff,
127:         sp: (hasWriteTrace ? e.emu_debug_sp() : e.emu_room_sp(room)) & 0xffff,
128:         writeTraceAvailable: hasWriteTrace,
129:         writeCount,
130:         writeCapacity,
131:         ram: ram.buffer,
132:         writes: writes.buffer,
133:       };
134:       if (hasWriteTrace) e.emu_debug_clear_writes();
135:       scope.postMessage({ type: 'debug-captured', ...result }, [ram.buffer, writes.buffer]);
136:     } else if (message.type === 'stop') {
137:       scope.close();
138:     }
139:   } catch (error) {
140:     scope.postMessage({ type: 'error', message: error instanceof Error ? error.message : String(error) });
141:   }
142: };
