133:   * @param object A pointer to a Z80 emulator instance.
134:   * @param state @c TRUE = line high; @c FALSE = line low. */
135: CPU_Z80_API void z80_int(Z80 *object, zboolean state);
136: Z_C_SYMBOLS_END
