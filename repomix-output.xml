 19:   workerIndex = message.workerIndex;
 20:   workerCount = message.workerCount;
 21:   shared = message.shared;
 22:   rangeStart = Math.floor(512 * workerIndex / workerCount);
 23:   rangeEnd = Math.floor(512 * (workerIndex + 1) / workerCount);
 24:   const base = import.meta.env.BASE_URL;
 25:   const response = await fetch(`${base}${shared ? 'z80-shared.wasm' : 'z80-single.wasm'}`);
 26:   if (!response.ok) throw new Error(`Could not load Z80 WebAssembly module (${response.status})`);
 27:   const bytes = await response.arrayBuffer();
 28:   let result: WebAssembly.WebAssemblyInstantiatedSource;
 29:   if (shared) {
 30:     if (!message.memory) throw new Error('Shared WebAssembly memory was not supplied.');
 31:     memory = message.memory;
 32:     result = await WebAssembly.instantiate(bytes, { env: { memory } });
 33:   } else {
 34:     result = await WebAssembly.instantiate(bytes, {});
 35:     memory = result.instance.exports.memory as WebAssembly.Memory;
 36:   }
 37:   wasm = result.instance.exports;
 38:   const e = wasm as Record<string, any>;
 39:   if (shared) {
 40:     const stackSize = 1024 * 1024;
 41:     e.__stack_pointer.value = e.__stack_high.value - workerIndex * stackSize;
 42:   }
 43:   scope.postMessage({ type: 'module-ready', workerIndex, workerCount, shared, rangeStart, rangeEnd });
 44: }
 45: function initialise(message: InitMessage) {
 46:   if (!wasm || !memory || workerIndex !== 0) throw new Error('Only worker 0 can initialise the shared Starquake machine.');
 47:   const e = wasm as Record<string, any>;
 48:   const heapBase = (e.__heap_base?.value ?? e.__data_end?.value ?? 0) + 1024;
 49:   const snapshot = new Uint8Array(message.snapshot);
 50:   const rom = new Uint8Array(message.rom);
 51:   const snapshotPtr = heapBase;
 52:   const romPtr = snapshotPtr + snapshot.byteLength + 16;
 53:   const required = romPtr + rom.byteLength + 16;
 54:   if (required > memory.buffer.byteLength) memory.grow(Math.ceil((required - memory.buffer.byteLength) / 65536));
