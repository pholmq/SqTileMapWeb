 152: #define VF(function, operand)						 \
 153: static Z_INLINE zuint8 pf_overflow_##function##8(zuint8 a, zuint8 b)	 \
 154: 	{								 \
 155: 	zsint total = ((zsint)((zsint8)a)) operand ((zsint)((zsint8)b)); \
 156: 									 \
 157: 	return total < -128 || total > 127 ? PF : 0;			 \
 158: 	}
