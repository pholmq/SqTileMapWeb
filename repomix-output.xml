30:   for (let i = 0x1800; i < 0x1b00; i++) if (screen[i] & 0x80) return true;
31:   return false;
32: }
33: export function paintSpectrumRoom(
34:   target: CanvasRenderingContext2D,
35:   room: number,
36:   screen: Uint8Array,
37:   flashPhase: boolean,
38: ) {
39:   let image = imageDataCache.get(target);
40:   if (!image) {
41:     image = target.createImageData(256, 144);
42:     imageDataCache.set(target, image);
43:   }
44:   const out = new Uint32Array(image.data.buffer, image.data.byteOffset, image.data.byteLength / 4);
45:   let dest = 0;
46:   const flash = flashPhase ? 1 : 0;
47:   for (let y = 48; y < 192; y++) {
48:     const bitmapBase = ((y & 0xc0) << 5) | ((y & 0x38) << 2) | ((y & 7) << 8);
49:     const attrBase = 0x1800 + ((y >> 3) << 5);
50:     for (let byteX = 0; byteX < 32; byteX++) {
51:       const bitmap = screen[bitmapBase + byteX];
52:       const attr = screen[attrBase + byteX];
53:       const lookup = (((flash * 256 + attr) * 256 + bitmap) * 8);
54:       for (let bit = 0; bit < 8; bit++) out[dest + bit] = pixelLookup[lookup + bit];
55:       dest += 8;
56:     }
57:   }
58:   target.putImageData(image, (room % 16) * 256, Math.floor(room / 16) * 144);
59: }
60: export function paintSpectrumHud(target: CanvasRenderingContext2D, screen: Uint8Array) {
61:   let image = hudImageDataCache.get(target);
62:   if (!image) {
63:     image = target.createImageData(256, 48);
64:     hudImageDataCache.set(target, image);
65:   }
66:   const out = new Uint32Array(image.data.buffer, image.data.byteOffset, image.data.byteLength / 4);
67:   let dest = 0;
68:   for (let y = 0; y < 48; y++) {
69:     const bitmapBase = ((y & 0xc0) << 5) | ((y & 0x38) << 2) | ((y & 7) << 8);
70:     const attrBase = 0x1800 + ((y >> 3) << 5);
71:     for (let byteX = 0; byteX < 32; byteX++) {
72:       const bitmap = screen[bitmapBase + byteX];
73:       const attr = screen[attrBase + byteX];
74:       const lookup = (((attr >> 6) & 1) * 256 + attr) * 256 + bitmap;
75:       const pixelBase = lookup * 8;
76:       for (let bit = 0; bit < 8; bit++) out[dest + bit] = pixelLookup[pixelBase + bit];
77:       dest += 8;
78:     }
79:   }
80:   target.putImageData(image, 0, 0);
81: }
