 70:   for (let room = rangeStart; room < rangeEnd; room++) {
 71:     /* take_dirty must always run so the flag is cleared; forceRoom sends the screen even if it is not dirty. */
 72:     if (e.emu_take_dirty(room) || room === forceRoom) {
 73:       const ptr = e.emu_screen_ptr(room) >>> 0;
