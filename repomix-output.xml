 261: static zuint8 const z_table[8] = {ZF, ZF, CF, CF, PF, PF, SF, SF};
 262: static Z_INLINE zboolean __zzz___(Z80 *object)
 263: 	{
 264: 	zuint8 z = (BYTE0 & 56) >> 3;
 265: 	return (F & (z_table[z]))
 266: 		?  (z & 1)  /* Flag is 1 */
 267: 		: !(z & 1); /* Flag is 0 */
 268: 	}
 269: /* MARK: - 8-Bit Arithmetic and Logical Operation Resolution and Execution
 270:    .----------.   .-----------.		.-------------------------------.
 271:    | 76543210 |   |	U     |		| S | Z | Y | H | X | P | N | C |
 272:    |----------|   |-----------|   .-----+---+---+---+---+---+---+---+---|
 273:    | __uuu___ |   | 000 = add |   | add | S | Z | 5 | H | 3 | V | 0 | C |
 274:    | _____vvv |   | 001 = adc |   |-----+---+---+---+---+---+---+---+---|
 275:    '----------'   | 010 = sub |   | adc | S | Z | 5 | H | 3 | V | 0 | C |
 276: 		  | 011 = sbc |   |-----+---+---+---+---+---+---+---+---|
 277: 		  | 100 = and |   | sub | S | Z | 5 | H | 3 | V | 1 | C |
 278: 		  | 101 = xor |   |-----+---+---+---+---+---+---+---+---|
 279: 		  | 110 = or  |   | sbc | S | Z | 5 | H | 3 | V | 1 | C |
 280: 		  | 111 = cp  |   |-----+---+---+---+---+---+---+---+---|
 281: 		  |-----------|   | and | S | Z | 5 | 1 | 3 | P | 0 | 0 |
 282: 		  |	V     |   |-----+---+---+---+---+---+---+---+---|
 283: 		  |-----------|   | xor | S | Z | 5 | 0 | 3 | P | 0 | 0 |
 284: 		  | 100 = inc |   |-----+---+---+---+---+---+---+---+---|
 285: 		  | 101 = dec |   | or  | S | Z | 5 | 0 | 3 | P | 0 | 0 |
 286: 		  '-----------'   |-----+---+---+---+---+---+---+---+---|
 287: 				  | cp  | S | Z |v.5| H |v.3| V | 1 | C |
 288: 				  |-----+---+---+---+---+---+---+---+---|
 289: 				  | inc | S | Z |v.5| H |v.3| V | 0 | . |
 290: 				  |-----+---+---+---+---+---+---+---+---|
 291: 				  | dec | S | Z |v.5| H |v.3| V | 1 | . |
 292: 				  '------------------------------------*/
 293: static void __uuu___(Z80 *object, zuint8 offset, zuint8 value)
 294: 	{
 295: 	zuint8 t;
 296: 	switch ((object->data.array_uint8[offset] >> 3) & 7)
 297: 		{
 298: 		case 0:	/* ADD */
 299: 		t = A + value;
 300: 		F =	((zuint)A + value > 255)     /* CF = Carry	*/
 301: 			| pf_overflow_add8(A, value) /* PF = Overflow	*/
 302: 			| ((A ^ value ^ t) & HF);    /* HF = Half-carry */
 303: 		A = t;				     /* NF = 0		*/
 304: 		break;
 305: 		case 1:	/* ADC */
 306: 		t = F_C;
 307: 		F =	((zuint)A + value + t > 255)		  /* CF = Carry	     */
 308: 			| pf_overflow_adc8(A, value, t)		  /* PF = Overflow   */
 309: 			| (((A & 0xF) + (value & 0xF) + t) & HF); /* HF = Half-carry */
 310: 								  /* NF = 0	     */
 311: 		A += value + t;
 312: 		break;
 313: 		case 2:	/* SUB */
 314: 		t = A - value;
 315: 		F =	(A < value)		     /* CF = Borrow	 */
 316: 			| NF			     /* NF = 1		 */
 317: 			| pf_overflow_sub8(A, value) /* PF = Overflow	 */
 318: 			| ((A ^ value ^ t) & HF);    /* HF = Half-Borrow */
 319: 		A = t;
 320: 		break;
 321: 		case 3: /* SBC */
 322: 		t = F_C;
 323: 		F =	((zsint)A - (zsint)value - (zsint)t < 0)  /* CF = Borrow      */
 324: 			| NF					  /* NF = 1	      */
 325: 			| pf_overflow_sbc8(A, value, t)		  /* PF = Overflow    */
 326: 			| (((A & 0xF) - (value & 0xF) - t) & HF); /* HF = Half-Borrow */
 327: 		A -= value + t;
 328: 		break;
 329: 		case 4: /* AND */
 330: 		A &= value;
 331: 		F = HF | PF_PARITY(A); /* HF = 1; PF = Parity */
 332: 		break;		       /* NF, CF = 0	      */
 333: 		case 5: /* XOR */
 334: 		A ^= value;
 335: 		F = PF_PARITY(A); /* PF = Parity    */
 336: 		break;		  /* HF, NF, CF = 0 */
 337: 		case 6: /* OR */
 338: 		A |= value;
 339: 		F = PF_PARITY(A); /* PF = Parity    */
 340: 		break;		  /* HF, NF, CF = 0 */
 341: 		case 7: /* CP */
 342: 		t = A - value;
 343: 		F = (zuint8)
 344: 			((A < value)		      /* CF = Borrow	    */
 345: 			 | NF			      /* NF = 1		    */
 346: 			 | pf_overflow_sub8(A, value) /* PF = Overflow	    */
 347: 			 | ((A ^ value ^ t) & HF)     /* HF = Half-Borrow   */
 348: 			 | (value & YXF)	      /* YF = v.5, XF = v.3 */
 349: 			 | ZF_ZERO(t)		      /* ZF = !(A - v)	    */
 350: 			 | (t & SF));		      /* SF = (A - v).7	    */
 351: 		return;
 352: 		}
 353: 	F = (zuint8)
 354: 		((F & (HF | PF | NF | CF)) /* CF, NF, PF and HF already changed */
 355: 		 | A_SYX		   /* SF = A.7; YF = A.5; XF = A.3	*/
 356: 		 | ZF_ZERO(A));		   /* ZF = !A				*/
 357: 	}
 358: static zuint8 _____vvv(Z80 *object, zuint8 offset, zuint8 value)
 359: 	{
 360: 	zuint8 t, pn;
 361: 	/* DEC */
 362: 	if (object->data.array_uint8[offset] & 1)
 363: 		{			      /* PF = Overflow */
 364: 		pn = value == 128 ? PNF : NF; /* NF = 1        */
 365: 		t = value - 1;
 366: 		}
 367: 	/* INC */
 368: 	else	{			    /* PF = Overflow */
 369: 		pn = value == 127 ? PF : 0; /* NF = 0	     */
 370: 		t = value + 1;
 371: 		}
 372: 	F = (zuint8)
 373: 		((F & CF)		  /* CF unchanged		  */
 374: 		 | pn			  /* PF and NF already calculated */
 375: 		 | (t & SYXF)		  /* SF = v.7; YF = v.5; XF = v.3 */
 376: 		 | ((value ^ 1 ^ t) & HF) /* HF = Half-Borrow		  */
 377: 		 | ZF_ZERO(t));		  /* ZF = !v			  */
 378: 	return t;
 379: 	}
 380: /* MARK: - Rotation and Shift Operation Resolution and Execution
 381:    .----------.   .-----------.
 382:    | 76543210 |   |	G     |
 383:    |----------|   |-----------|
 384:    | __ggg___ |   | 000 = rlc |
 385:    '----------'   | 001 = rrc |
 386: 		  | 010 = rl  |
 387: 		  | 011 = rr  |
 388: 		  | 100 = sla |
 389: 		  | 101 = sra |
 390: 		  | 110 = sll |
 391: 		  | 111 = srl |
 392: 		  '----------*/
 393: static zuint8 __ggg___(Z80 *object, zuint8 offset, zuint8 value)
 394: 	{
 395: 	zuint8 c;
 396: 	switch ((object->data.array_uint8[offset] >> 3) & 7)
 397: 		{
 398: 		/* RLC		 .----------------.
 399: 			.----.   |  .---------.   |
 400: 			| CF |<-----| 7 <-- 0 |<--'
 401: 			'----'	    '--------*/
 402: 		case 0:
 403: 		ROL(value);
 404: 		c = value & CF;
 405: 		break;
 406: 		/* RRC	.----------------.
 407: 			|   .---------.  |   .----.
 408: 			'-->| 7 --> 0 |----->| CF |
 409: 			    '---------'      '---*/
 410: 		case 1:
 411: 		c = value & CF;
 412: 		ROR(value);
 413: 		break;
 414: 		/* RL	.-------------------------.
 415: 			|  .----.   .---------.   |
 416: 			'--| CF |<--| 7 <-- 0 |<--'
 417: 			   '----'   '--------*/
 418: 		case 2:
 419: 		c = value >> 7;
 420: 		value = (zuint8)((value << 1) | F_C);
 421: 		break;
 422: 		/* RR	.-------------------------.
 423: 			|   .---------.   .----.  |
 424: 			'-->| 7 --> 0 |-->| CF |--'
 425: 			    '---------'   '---*/
 426: 		case 3:
 427: 		c = value & CF;
 428: 		value = (zuint8)((value >> 1) | (F_C << 7));
 429: 		break;
 430: 		/* SLA	.----.	 .---------.
 431: 			| CF |<--| 7 <-- 0 |<-- 0
 432: 			'----'	 '--------*/
 433: 		case 4:
 434: 		c = value >> 7;
 435: 		value <<= 1;
 436: 		break;
 437: 		/* SRA	    .---------.   .----.
 438: 			.-->| 7 --> 0 |-->| CF |
 439: 			|   '---------'   '----'
 440: 			|     |
 441: 			'----*/
 442: 		case 5:
 443: 		c = value & CF;
 444: 		value = (value & 128) | (value >> 1);
 445: 		break;
 446: 		/* SLL	.----.	 .---------.
 447: 			| CF |<--| 7 <-- 0 |<-- 1
 448: 			'----'	 '--------*/
 449: 		case 6:
 450: 		c = value >> 7;
 451: 		value = (value << 1) & 1;
 452: 		break;
 453: 		/* SRL	     .---------.   .----.
 454: 			0 -->| 7 --> 0 |-->| CF |
 455: 			     '---------'   '---*/
 456: 		case 7:
 457: 		c = value & CF;
 458: 		value >>= 1;
 459: 		break;
 460: 		/* Uncoment to Avoid a compiler warning */
 461: 		/*default: c = 0; break;*/
 462: 		}
 463: 	F = (zuint8)((value & SYXF) | ZF_ZERO(value) | PF_PARITY(value) | c);
 464: 	return value;
 465: 	}
 466: /* MARK: - Bit Set and Reset Operation Resolution and Execution
 467:    .----------.   .---------.
 468:    | 76543210 |   |    M    |
 469:    |----------|   |---------|
 470:    | _m______ |   | 0 = res |
 471:    '----------'   | 1 = set |
 472: 		  '--------*/
 473: static Z_INLINE zuint8 _m______(Z80 *object, zuint8 offset, zuint8 value)
 474: 	{
 475: 	zuint8 t = object->data.array_uint8[offset];
 476: 	return (zuint8)((t & 64)
 477: 		? value |  (1 << ((t & 56) >> 3))   /* SET */
 478: 		: value & ~(1 << ((t & 56) >> 3))); /* RES */
 479: 	}
