 3:   [0, 205, 0], [0, 205, 205], [205, 205, 0], [205, 205, 205],
 4: ];
 5: const bright = [
 6:   [0, 0, 0], [0, 0, 255], [255, 0, 0], [255, 0, 255],
 7:   [0, 255, 0], [0, 255, 255], [255, 255, 0], [255, 255, 255],
 8: ];
